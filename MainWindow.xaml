<Window x:Class="DeepUninstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DeepUninstaller"
    Style="{StaticResource DarkWindowStyle}"
    Title="UninstallTrace" Width="1100" Height="680" MinWidth="940" MinHeight="560"
    WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Thickness x:Key="SizeCellPadding">8,0</Thickness>
        <Style x:Key="SizeCell" TargetType="DataGridCell" BasedOn="{StaticResource DarkGridCell}">
            <Setter Property="Padding" Value="{StaticResource SizeCellPadding}"/>
        </Style>
        <Style x:Key="InventoryNumberText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="InventorySizeText" TargetType="TextBlock" BasedOn="{StaticResource InventoryNumberText}">
            <Setter Property="ToolTip" Value="{Binding SizeHint}"/>
        </Style>
        <Style x:Key="WrappedListCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ToolTip" Value="{local:UiText '选中文字后按 Ctrl+C 复制', 'Select text and press Ctrl+C to copy'}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,4">
                <TextBlock x:Name="AccountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                           FontSize="12" Margin="12,0,3,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Button x:Name="AppsNav" Style="{StaticResource NavButton}" Click="ShowApps"
                            Content="{local:UiText '已安装程序', 'Installed apps'}"/>
                    <Button x:Name="AttemptsNav" Style="{StaticResource NavButton}" Click="ShowAttempts"
                            Content="{local:UiText '卸载记录', 'Uninstall history'}"/>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="ShowHistory"
                            Content="{local:UiText '清理恢复', 'Cleanup recovery'}"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="ShowSettings"
                            Content="{local:UiText '设置', 'Settings'}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="8" Margin="12,8,12,0" Padding="9,6" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="DownloadUpdateButton" Content="{local:UiText '下载更新', 'Download update'}" Style="{StaticResource PrimaryButton}"
                            Click="OnDownloadUpdate" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="InstallUpdateButton" Content="{local:UiText '重启并更新', 'Restart and update'}" Style="{StaticResource PrimaryButton}"
                            Click="OnInstallUpdate" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="CancelUpdateDownloadButton" Content="{local:UiText '取消下载', 'Cancel download'}"
                            Click="OnCancelUpdateDownload" Visibility="Collapsed"/>
                    <Button x:Name="OpenBannerReleaseButton" Content="{local:UiText '查看发行页', 'View release'}" Click="OnOpenProjectPage"
                            Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="DismissUpdateButton" Content="{local:UiText '稍后', 'Later'}" Click="OnDismissUpdate"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="UpdateBannerProgress" Maximum="100" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="{local:UiText '更新下载进度', 'Update download progress'}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="AppsView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Border Background="{StaticResource InputBrush}" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInput}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchInput" Margin="26,1,1,1" MinHeight="30" Padding="7,3" Background="Transparent" BorderThickness="0" TextChanged="OnFilterChanged"
                                 ToolTip="{local:UiText '搜索程序（Ctrl+F）', 'Search apps (Ctrl+F)'}"
                                 AutomationProperties.Name="{local:UiText '搜索程序、发布者或版本', 'Search apps, publishers, or versions'}"/>
                        <TextBlock Text="{local:UiText '搜索程序、发布者或版本', 'Search apps, publishers, or versions'}" Margin="33,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox x:Name="IncludeProtected" Grid.Column="1" Content="{local:UiText '显示系统和受保护项', 'Show system and protected apps'}" Margin="12,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <Button x:Name="RefreshButton" Grid.Column="2" Content="{local:UiText '刷新', 'Refresh'}" Click="OnRefresh"
                            ToolTip="{local:UiText '刷新程序列表（F5）', 'Refresh installed apps (F5)'}"/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock x:Name="InventoryCount" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Label Content="{local:UiText '排序', 'Sort'}" Target="{Binding ElementName=AppSortSelector}"
                               Foreground="{StaticResource MutedBrush}" Padding="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AppSortSelector" MinHeight="29" Padding="8,3" SelectedIndex="0" SelectionChanged="OnAppSortChanged"
                                  AutomationProperties.Name="{local:UiText '已安装程序排序', 'Sort installed apps'}">
                            <ComboBoxItem Content="{local:UiText '最新安装优先', 'Newest first'}"/>
                            <ComboBoxItem Content="{local:UiText '最早安装优先', 'Oldest first'}"/>
                            <ComboBoxItem Content="{local:UiText '名称 A–Z', 'Name A–Z'}"/>
                            <ComboBoxItem Content="{local:UiText '名称 Z–A', 'Name Z–A'}"/>
                            <ComboBoxItem x:Name="HeaderAppSort" IsEnabled="False" Visibility="Collapsed"/>
                        </ComboBox>
                    </StackPanel>
                    <WrapPanel>
                        <Button x:Name="BatchButton" Content="{local:UiText '批量卸载', 'Batch uninstall'}" Click="OnBatchUninstall"
                                Margin="0,0,6,0" IsEnabled="False"
                                ToolTip="{local:UiText '选择多个程序，按顺序运行原厂卸载', 'Select multiple apps and run their original uninstallers in order'}"/>
                        <Button x:Name="OrphanButton" Content="{local:UiText '扫描已移除程序', 'Scan removed app'}" Click="OnOrphanScan" IsEnabled="False"
                                Margin="0,0,6,0"
                                ToolTip="{local:UiText '从已知程序名称与安装位置查找残留', 'Look for leftovers using a known app name and install location'}"/>
                        <Button x:Name="StoreButton" Content="{local:UiText 'Windows 应用', 'Windows apps'}" Click="OnStoreApps" IsEnabled="False"
                                ToolTip="{local:UiText '管理当前用户安装的打包应用', 'Manage packaged apps installed for the current user'}"/>
                    </WrapPanel>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AppListPane" Width="4*" MinWidth="470"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition x:Name="AppDetailPane" Width="*" MinWidth="194" MaxWidth="410"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <DataGrid x:Name="AppGrid" Margin="1,1,1,4" IsReadOnly="True" RowHeight="NaN" MinRowHeight="36"
                                      VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnAppSelected" Sorting="OnAppGridSorting"
                                      AutomationProperties.Name="{local:UiText '已安装程序', 'Installed apps'}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:UiText '程序', 'App'}" Binding="{Binding Name}" Width="2.3*" MinWidth="112" SortMemberPath="Name" ElementStyle="{StaticResource WrappedListCellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '发布者', 'Publisher'}" Binding="{Binding Publisher}" Width="1.25*" MinWidth="79" SortMemberPath="Publisher" ElementStyle="{StaticResource WrappedListCellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '版本', 'Version'}" Binding="{Binding Version}" Width="1.15*" MinWidth="64" SortMemberPath="Version" ElementStyle="{StaticResource WrappedListCellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '安装日期', 'Installed'}" Binding="{Binding InstallDate}"
                                                        Width="100" SortMemberPath="InstalledOn" ElementStyle="{StaticResource InventoryNumberText}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                                <Setter Property="ToolTip" Value="{local:UiText '日期来自 Windows 卸载登记。MSI 更新或修复后，该日期可能变化。', 'Date from the Windows uninstall registration. MSI updates or repairs can change it.'}"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="InventorySizeColumn" Header="{local:UiText '大小', 'Size'}"
                                                        Binding="{Binding Size}" Width="Auto" SortMemberPath="Size"
                                                        CellStyle="{StaticResource SizeCell}" ElementStyle="{StaticResource InventorySizeText}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkGridHeader}">
                                                <Setter Property="ToolTip" Value="{local:UiText '优先使用登记大小，缺失时核算独立安装目录。≥ 表示仅统计到一部分，— 表示大小未知。', 'Installer estimate or measured installation folder. ≥ indicates a partial measurement. A dash means unknown.'}"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="InventoryEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                        </Grid>
                    </Border>
                    <GridSplitter x:Name="DetailSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                                  Focusable="True" KeyboardIncrement="12"
                                  AutomationProperties.Name="{local:UiText '调整列表和详情宽度', 'Resize list and details'}"
                                  ToolTip="{local:UiText '拖动分隔线，或聚焦后用左右方向键调整宽度', 'Drag to resize, or focus and use the arrow keys'}">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Grid Background="{TemplateBinding Background}">
                                    <Border x:Name="Grip" Width="2" Height="30" CornerRadius="1" Background="{StaticResource ControlBorderBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource FocusBrush}"/>
                                        <Setter TargetName="Grip" Property="Width" Value="3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="11" CornerRadius="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="UninstallButton" Content="{local:UiText '运行卸载', 'Run uninstaller'}" Style="{StaticResource PrimaryButton}" Click="OnUninstall" Margin="0,0,0,6" IsEnabled="False"/>
                                <Button x:Name="ScanButton" Content="{local:UiText '扫描残留', 'Scan for leftovers'}" Click="OnScan" IsEnabled="False"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBox x:Name="AppName" Text="{local:UiText '选择一个程序', 'Select an app'}" Style="{StaticResource DetailValue}"
                                             FontSize="16" FontWeight="SemiBold" AutomationProperties.Name="{local:UiText '程序名称', 'Program name'}"/>
                                    <StackPanel x:Name="AppDetails" Visibility="Collapsed">
                                        <TextBox x:Name="AppPublisher" Style="{StaticResource DetailValue}" Foreground="{StaticResource MutedBrush}"
                                                 AutomationProperties.Name="{local:UiText '发布者', 'Publisher'}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="AppRoleEvidence" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,9,0,9"/>
                                        <TextBlock Text="{local:UiText '版本', 'Version'}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBox x:Name="AppVersion" Style="{StaticResource DetailValue}" Margin="0,1,0,6"
                                                 AutomationProperties.Name="{local:UiText '完整版本号', 'Full version'}"/>
                                        <TextBlock x:Name="AppSizeLabel" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBox x:Name="AppSize" Style="{StaticResource DetailValue}" Margin="0,1,0,6"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=AppSizeLabel}"/>
                                        <TextBlock Text="{local:UiText '安装信息', 'Installation details'}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock x:Name="AppScope" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <TextBlock Text="{local:UiText '安装位置', 'Install location'}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBox x:Name="AppPath" Style="{StaticResource DetailValue}" Margin="0,1,0,7"
                                                 AutomationProperties.Name="{local:UiText '安装位置', 'Install location'}"/>
                                        <TextBlock Text="{local:UiText '卸载命令', 'Uninstall command'}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBox x:Name="AppCommand" Style="{StaticResource DetailValue}" Margin="0,1,0,0"
                                                 AutomationProperties.Name="{local:UiText '卸载命令', 'Uninstall command'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="AttemptsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="ResumeScanButton" Content="{local:UiText '继续扫描残留', 'Resume leftover scan'}" Style="{StaticResource PrimaryButton}" Click="OnResumeScan" IsEnabled="False" Margin="0,0,6,0"/>
                    <Button Content="{local:UiText '刷新记录', 'Refresh log'}" Click="OnAttemptsRefresh"/>
                </WrapPanel>
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <DataGrid x:Name="AttemptsGrid" Margin="1,1,1,4" IsReadOnly="True" SelectionChanged="OnAttemptSelected"
                                  AutomationProperties.Name="{local:UiText '卸载记录', 'Uninstall history'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:UiText '程序', 'App'}" Binding="{Binding Attempt.App.Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:UiText '开始时间', 'Started'}" Binding="{Binding Time}" Width="158" SortMemberPath="Attempt.StartedAt" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:UiText '结果', 'Result'}" Binding="{Binding Outcome}" Width="171" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:UiText '退出码', 'Exit code'}" Binding="{Binding Attempt.ExitCode}" Width="83" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AttemptsEmpty" Text="{local:UiText '原厂卸载记录会显示在这里', 'Uninstall attempts will appear here'}" Visibility="Collapsed" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="HistoryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <WrapPanel>
                        <Button x:Name="RestoreButton" Content="{local:UiText '恢复隔离项', 'Restore quarantined items'}" Style="{StaticResource PrimaryButton}" Click="OnRestore" IsEnabled="False" Margin="0,0,6,0"/>
                        <Button x:Name="DiscardButton" Content="{local:UiText '永久删除恢复副本', 'Permanently delete recovery copies'}" Click="OnDiscard" IsEnabled="False" Margin="0,0,6,0"/>
                        <Button x:Name="RecoveryRescanButton" Content="{local:UiText '重新扫描残留', 'Scan leftovers again'}" Click="OnRecoveryRescan"
                                Visibility="Collapsed" Margin="0,0,6,0"/>
                        <Button x:Name="RemoveHistoryButton" Content="{local:UiText '删除记录', 'Delete record'}" Click="OnRemoveHistoryRecord"
                                Visibility="Collapsed" Margin="0,0,6,0"
                                ToolTip="{local:UiText '删除选中的清理记录', 'Delete the selected cleanup record'}"/>
                        <Button Content="{local:UiText '刷新', 'Refresh'}" Click="OnHistoryRefresh" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ShowCompletedHistory" Content="{local:UiText '显示已结束记录', 'Show finished records'}"
                                  VerticalAlignment="Center" Checked="OnHistoryFilterChanged" Unchecked="OnHistoryFilterChanged"/>
                    </WrapPanel>
                    <TextBlock Text="{local:UiText '仅恢复本工具隔离的文件和注册表项。要重新安装软件，请使用安装包或应用商店。', 'Restore files and registry items quarantined here. To reinstall an app, use its installer or the Store.'}"
                               Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="HistoryTables" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="100"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="3*" MinHeight="100"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <DataGrid x:Name="HistoryGrid" Margin="1,1,1,4" IsReadOnly="True" SelectionChanged="OnSessionSelected"
                                      AutomationProperties.Name="{local:UiText '清理恢复', 'Cleanup recovery'}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:UiText '程序', 'App'}" Binding="{Binding Session.AppName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '清理时间', 'Cleaned'}" Binding="{Binding Time}" Width="165" SortMemberPath="Session.CreatedAt" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '已隔离', 'Quarantined'}" Binding="{Binding Quarantined}" Width="82" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '已恢复', 'Restored'}" Binding="{Binding Restored}" Width="82" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{local:UiText '待核对', 'Needs review'}" Binding="{Binding Failed}" Width="108" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <DataGrid x:Name="EntryGrid" Margin="1,1,1,4" IsReadOnly="True" RowHeight="NaN" MinRowHeight="36"
                                  AutomationProperties.Name="{local:UiText '所选清理的处理结果', 'Results for the selected cleanup'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:UiText '状态', 'Status'}" Binding="{Binding State}" Width="143" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{local:UiText '项目', 'Item'}" Binding="{Binding Target}" Width="2*" ElementStyle="{StaticResource WrappedListCellText}"/>
                                <DataGridTextColumn Header="{local:UiText '处理结果', 'Details'}" Binding="{Binding Details}" Width="1.3*" ElementStyle="{StaticResource WrappedListCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
                <TextBlock x:Name="HistoryEmpty" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{local:UiText '界面语言', 'Display language'}" FontSize="15" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,7,0,0">
                                    <RadioButton x:Name="SystemLanguage" GroupName="DisplayLanguage" Content="{local:UiText '跟随 Windows', 'Use Windows language'}"
                                                 Checked="OnLanguageChoiceChanged" Margin="0,0,16,4"/>
                                    <RadioButton x:Name="ChineseLanguage" GroupName="DisplayLanguage" Content="简体中文" Checked="OnLanguageChoiceChanged" Margin="0,0,16,4"/>
                                    <RadioButton x:Name="EnglishLanguage" GroupName="DisplayLanguage" Content="English" Checked="OnLanguageChoiceChanged" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <Button x:Name="ApplyLanguageButton" Content="{local:UiText '应用语言', 'Apply language'}" Style="{StaticResource PrimaryButton}"
                                        Click="OnApplyLanguage" IsEnabled="False" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:UiText '关于与更新', 'About and updates'}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AppVersionText" Style="{StaticResource MutedText}" Margin="0,5,0,7"/>
                                <CheckBox x:Name="AutoUpdateCheckBox" Content="{local:UiText '打开软件时检查更新', 'Check for updates when opening the app'}"
                                          Click="OnAutoUpdateChanged" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="CheckUpdatesButton" Content="{local:UiText '检查更新', 'Check for updates'}"
                                            Click="OnCheckForUpdate" Margin="0,0,6,4"/>
                                    <Button x:Name="OpenRepositoryButton" Content="{local:UiText 'GitHub 仓库', 'GitHub repository'}"
                                            Click="OnOpenProjectPage" ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="0,0,6,4"/>
                                    <Button x:Name="OpenReleasesButton" Content="{local:UiText '发行记录', 'Release history'}"
                                            Click="OnOpenProjectPage" ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="0,0,0,4"/>
                                    <Button x:Name="ShowUpdateButton" Content="{local:UiText '显示更新提示', 'Show update notice'}" Click="OnShowUpdate"
                                            Margin="6,0,0,4" Visibility="Collapsed"/>
                                </WrapPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="OpenUpdateButton" Content="{local:UiText '查看新版', 'View new release'}" Click="OnOpenProjectPage"
                                        ToolTip="{Binding Tag, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:UiText '键盘快捷键', 'Keyboard shortcuts'}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:UiText 'Ctrl+F　搜索已安装程序', 'Ctrl+F   Search installed apps'}" Margin="0,7,0,0"/>
                                <TextBlock Text="{local:UiText 'F5　刷新当前列表', 'F5   Refresh the current list'}" Margin="0,4,0,0"/>
                                <TextBlock Text="{local:UiText '空格　勾选审查窗口中当前的残留项', 'Space   Toggle the selected leftover in the review window'}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{local:UiText 'Esc　关闭审查窗口', 'Esc   Close the review window'}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <DockPanel Grid.Row="1" Margin="1,7,1,0">
                <Button x:Name="StopWaitButton" Content="{local:UiText '停止等待', 'Stop waiting'}" DockPanel.Dock="Right" Click="OnStopWait"
                        Visibility="Collapsed" MinHeight="25" Padding="7,2" FontSize="12" Margin="8,0,0,0"/>
                <ProgressBar x:Name="BusyProgress" DockPanel.Dock="Right" IsIndeterminate="True" Width="95" Height="4" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="SizeProgressText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="{local:UiText '正在读取已安装程序…', 'Loading installed apps…'}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
