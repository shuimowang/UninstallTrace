<Window x:Class="DeepUninstaller.OrphanScanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DarkWindowStyle}"
    Width="620" SizeToContent="Height" MinWidth="520" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="23">
        <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="Help" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,17"/>
        <Label x:Name="NameLabel" Target="{Binding ElementName=AppName}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,5"/>
        <TextBox x:Name="AppName" MaxLength="150" TextChanged="OnNameChange" Margin="0,0,0,12"/>
        <Label x:Name="PublisherLabel" Target="{Binding ElementName=Publisher}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,5"/>
        <TextBox x:Name="Publisher" MaxLength="150" Margin="0,0,0,12"/>
        <Label x:Name="LocationLabel" Target="{Binding ElementName=Location}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,5"/>
        <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Click="OnBrowse" Margin="7,0,0,0"/>
            <TextBox x:Name="Location"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="76"/>
            <Button x:Name="ScanButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnScan" Margin="8,0,0,0" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
