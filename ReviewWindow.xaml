<Window x:Class="DeepUninstaller.ReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DeepUninstaller"
    Title="{local:UiText '残留审查', 'Review leftovers'}" Width="1050" Height="670" MinWidth="770" MinHeight="550"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="25,21,25,19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{local:UiText '残留审查', 'Review leftovers'}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProductText" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="17"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,11" LastChildFill="True">
            <StackPanel x:Name="SelectionTools" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{local:UiText '仅选择强归属项', 'Select strong matches'}" Click="OnSelectStrong" Margin="0,0,7,0"/>
                <Button Content="{local:UiText '取消全选', 'Clear selection'}" Click="OnClear"/>
            </StackPanel>
            <TextBlock x:Name="ReviewCount" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
        </DockPanel>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <DataGrid x:Name="ReviewGrid" IsReadOnly="True" SelectionChanged="OnSelectionChanged" Margin="1,1,1,6" PreviewKeyDown="OnReviewGridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ChoiceColumn" Width="45" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding Target}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:UiText '类型', 'Type'}" Binding="{Binding Kind}" Width="117" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '归属', 'Match'}" Binding="{Binding Confidence}" Width="111" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '位置', 'Location'}" Binding="{Binding Target}" Width="1.8*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '依据', 'Evidence'}" Binding="{Binding Item.Evidence}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="{local:UiText '未找到符合扫描规则的残留', 'No attributable leftovers found'}" Visibility="Collapsed" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <StackPanel x:Name="ItemDetail" Grid.Row="3" Margin="0,9,0,0" Visibility="Collapsed">
            <TextBox x:Name="LocationText" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontSize="12" Padding="8,4"
                     AutomationProperties.Name="{local:UiText '项目完整位置', 'Full item location'}"/>
            <TextBlock x:Name="EvidenceText" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <Expander x:Name="Warnings" Grid.Row="4" Foreground="{StaticResource WarningBrush}" Margin="0,9,0,0" Visibility="Collapsed">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" Padding="3,5"/>
            </ScrollViewer>
        </Expander>
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="CleanupHint" Text="{local:UiText '清理会移走选中项并保留恢复副本。配置和个人数据可能包含在其中。', 'Cleanup moves selected items into quarantine and keeps recovery copies. Selected items can include settings and personal data.'}"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12"/>
                <CheckBox x:Name="ManualConsent" Visibility="Collapsed" Checked="OnConsent" Unchecked="OnConsent" Margin="0,7,0,0">
                    <TextBlock Text="{local:UiText '我已核实选中项的归属，并理解清理可能影响仍在使用的程序。', 'I verified that the selected items belong to this app and understand cleanup can affect an app still in use.'}" TextWrapping="Wrap" FontSize="12"/>
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{local:UiText '关闭', 'Close'}" IsCancel="True" MinWidth="70"/>
                <Button x:Name="CleanButton" Content="{local:UiText '隔离选中项', 'Quarantine selected'}" Style="{StaticResource PrimaryButton}" MinWidth="121" Margin="8,0,0,0" Click="OnClean"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
