<Window x:Class="DeepUninstaller.StoreAppsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DeepUninstaller"
    Style="{StaticResource DarkWindowStyle}"
    Title="{local:UiText '商店应用', 'Store apps'}" Width="970" Height="660" MinWidth="690" MinHeight="500"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="OnLoaded" Closing="OnClosing">
    <Grid Margin="25,21,25,19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="{local:UiText '商店应用', 'Store apps'}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{local:UiText '当前账户的 Windows 应用包', 'Windows app packages for the current account'}"
                       Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="StoreSearch" TextChanged="OnFilterChanged"
                         AutomationProperties.Name="{local:UiText '搜索应用或包标识', 'Search apps or package identities'}"/>
                <TextBlock Text="{local:UiText '搜索应用或包标识', 'Search apps or package identities'}" Margin="12,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=StoreSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <CheckBox x:Name="IncludeProtected" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                      Content="{local:UiText '显示受保护的包', 'Show protected packages'}" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            <Button x:Name="StoreRefresh" Grid.Column="2" Content="{local:UiText '刷新', 'Refresh'}" Click="OnRefresh"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <DataGrid x:Name="StoreGrid" IsReadOnly="True" Margin="1,1,1,5" SelectionChanged="OnSelectionChanged"
                          AutomationProperties.Name="{local:UiText '商店应用包', 'Store app packages'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{local:UiText '应用', 'App'}" Binding="{Binding App.DisplayName}"
                                            Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '应用包', 'Package'}" Binding="{Binding App.Name}"
                                            Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '版本', 'Version'}" Binding="{Binding App.Version}"
                                            Width="100" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{local:UiText '卸载状态', 'Removal status'}" Binding="{Binding State}"
                                            Width="140" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBox x:Name="StoreFullName" Grid.Row="3" Margin="0,9,0,0" Visibility="Collapsed" IsReadOnly="True"
                 IsReadOnlyCaretVisible="True" AutomationProperties.Name="{local:UiText '应用包完整标识', 'Package full name'}"/>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="StoreStatus" TextWrapping="Wrap" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="StoreProgress" IsIndeterminate="True" Height="3" Width="90" HorizontalAlignment="Left"
                             Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StoreClose" Content="{local:UiText '关闭', 'Close'}" IsCancel="True" MinWidth="70"/>
                <Button x:Name="StoreRemove" Content="{local:UiText '卸载应用', 'Uninstall app'}" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="OnRemove" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
