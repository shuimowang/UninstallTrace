<Window x:Class="DeepUninstaller.BatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DarkWindowStyle}"
    Width="755" Height="545" MinWidth="600" MinHeight="410"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HelpText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,9"/>
        <TextBox x:Name="Search" Grid.Row="1" Margin="0,0,0,8" TextChanged="OnSearch"/>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="Choices" IsReadOnly="True" Sorting="OnSort" Margin="1,1,1,5">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="45" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding App.Name}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="AppColumn" Binding="{Binding App.Name}" CanUserSort="False" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn x:Name="DateColumn" Binding="{Binding DateLabel}" Width="106" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn x:Name="PublisherColumn" Binding="{Binding App.Publisher}" CanUserSort="False" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn x:Name="VersionColumn" Binding="{Binding App.Version}" CanUserSort="False" Width="83" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn x:Name="ScopeColumn" Binding="{Binding App.Scope}" CanUserSort="False" Width="95" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="CancelButton" IsCancel="True" MinWidth="76"/>
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnStart"/>
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
        </DockPanel>
    </Grid>
</Window>
