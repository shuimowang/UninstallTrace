<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UninstallTrace</AssemblyName>
    <Product>UninstallTrace</Product>
    <Description>Windows uninstaller with leftover review and recovery</Description>
    <Version>0.1.2</Version>
    <RepositoryUrl>https://github.com/shuimowang/UninstallTrace</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/UninstallTrace.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);verification\**;release\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
